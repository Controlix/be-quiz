DATABASE_URL="postgresql://quiz:quiz@localhost:5432/be_quiz?schema=public"
APP_URL="http://localhost:3000"

# Deployment Capabilities (Strictly explicit opt-in: default is false)
ENABLE_AI_VISION=false              # Set to true to enable flyer upload & AI extraction
ENABLE_ICAL_EXPORT=false            # Set to true to enable dynamic .ics calendar export
ENABLE_WHATSAPP_SHARE=false         # Set to true to enable WhatsApp roster formatting
ENABLE_EMAIL_REGISTRATION=false     # Set to true to enable organizer email registration helper
ENABLE_SHARED_GOOGLE_CALENDAR=false # Set to true to enable automated shared team Google Calendar sync

# Google Service Account Credentials (Required when ENABLE_SHARED_GOOGLE_CALENDAR=true)
# GOOGLE_CALENDAR_ID: The target Google Calendar ID from Google Calendar settings (e.g. your_group_id@group.calendar.google.com)
# GOOGLE_SERVICE_ACCOUNT_EMAIL: The client_email from your Google Cloud Service Account JSON key file
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY: The private_key from the JSON key file.
# When setting in .env or cloud environments, preserve multiline PEM format or escape newlines as \n within double quotes:
# Example: "-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgk...=\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID=""
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
